# ---- Backend (backend/.env) ----
# App
APP_NAME=MemeShare
ENVIRONMENT=development
DEBUG=true
# SQL_ECHO logs every statement (with parameter values) — leave off unless debugging queries
SQL_ECHO=false
API_V1_PREFIX=/api/v1

# Database — SQLite file for local dev (no server needed).
# For production use: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./memeshare.db

# Auth / JWT
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# CORS — comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5174

# Storage: "local" (writes to LOCAL_STORAGE_DIR, served at /media), "s3", or
# "cloudinary" (recommended for production — memes + avatars persist in a
# Cloudinary account so redeploys don't lose them).
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=media_store
LOCAL_STORAGE_PUBLIC_URL=http://localhost:8000/media

# S3 / MinIO — only needed when STORAGE_BACKEND=s3 (requires the `prod` extra for boto3)
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=memeshare-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Cloudinary — only needed when STORAGE_BACKEND=cloudinary (requires the `prod` extra).
# Either paste the single CLOUDINARY_URL from your dashboard ("API Environment
# variable"), or set the three discrete values. CLOUDINARY_URL wins if both are set.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upload limits (bytes)
MAX_IMAGE_BYTES=10485760
MAX_VIDEO_BYTES=52428800
MAX_REQUEST_BYTES=67108864

# ---- Frontend (frontend/.env) ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws/chat
